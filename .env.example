# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here

# Environment Mode (True=development, False=production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Engine: sqlite3, mysql, or postgresql
DB_ENGINE=sqlite3

# Database (for mysql/postgresql only)
DB_NAME=crossview
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Production Security (set to False for local testing without HTTPS)
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Paystack Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional legacy redirect callback while Popup is active.
PAYSTACK_CALLBACK_URL=http://localhost:8000/payments/paystack/callback/

# Optional inquiry recipient override. Leave blank to use PlatformSettings.
INQUIRY_NOTIFICATION_EMAIL=

# Optional Google Classroom companion integration. Keep One Tap sign-in separate.
GOOGLE_CLASSROOM_ENABLED=False
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLASSROOM_TOKEN_ENCRYPTION_KEY=
# Preferred shared settings for Classroom, Calendar and Meet. When blank,
# the existing GOOGLE_CLASSROOM_* values above remain the compatibility fallback.
GOOGLE_WORKSPACE_ENABLED=False
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=
GOOGLE_WORKSPACE_TOKEN_ENCRYPTION_KEY=
PLATFORM_PUBLIC_BASE_URL=

# Transactional email. Production requires all three values below. Create a
# deployment-specific API key in Brevo; never commit a real key.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=notifications@example.com
# Optional display-name and reply-to overrides. PlatformSettings supplies the
# institution name and contact email when these are blank.
EMAIL_FROM_NAME=
DEFAULT_REPLY_TO_EMAIL=
# Product repositories may select a product-owned layout.
EMAIL_LAYOUT_TEMPLATE=emails/platform_message.html
# Optional product-owned logo path or absolute URL. Blank uses PlatformSettings.
EMAIL_LOGO_URL=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Performance tuning
DB_CONN_MAX_AGE=60
CACHE_LOCATION=/tmp/lms-cache
CACHE_TIMEOUT=900
ENABLE_PERF_LOGGING=False
SLOW_REQUEST_MS=400
